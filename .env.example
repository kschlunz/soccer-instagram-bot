# football-data.org API token (free tier is enough): https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=your-football-data-token

# Instagram Graph API. See README.md for how to get these.
IG_USER_ID=17841400000000000
IG_ACCESS_TOKEN=EAAG...
# Optional. Default is the Facebook Graph host. Use https://graph.instagram.com/v21.0
# if your token came from "Instagram API with Instagram Login".
# IG_API_BASE=https://graph.facebook.com/v21.0

# Timezone that kickoff times are shown in (IANA name).
TIMEZONE=America/New_York

# Optional comma-separated football-data.org competition codes. Empty = everything
# your plan includes. Free tier: PL ELC PD BL1 SA FL1 DED PPL CL EC WC BSA CLI
# COMPETITIONS=PL,PD,BL1,SA,FL1,CL

# Post a "no matches today" image instead of skipping quiet days (true/false).
POST_WHEN_EMPTY=false

# Git branch the generated images are pushed to so Instagram can download them.
IMAGES_BRANCH=soccer-bot-images

# Optional extra caption footer / hashtags.
HASHTAGS=#soccer #football #matchday #fixtures #futbol
